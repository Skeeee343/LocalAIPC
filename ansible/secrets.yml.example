# Copy to ansible/secrets.yml (plaintext for first run, or encrypted:
# ansible-vault create ansible/secrets.yml). Never commit the real file.
# Loaded by site.yml when present; empty defaults in site.yml win otherwise.
tailscale_authkey: ""
discord_bot_token: ""
discord_guild_id: ""
discord_user_id: ""
# Mac admin pubkey for SSH login (paste `cat ~/.ssh/id_ed25519.pub` output):
admin_ssh_key: ""
duckdns_domain: ""
duckdns_token: ""
# Mac-local only (adapter runs beside SP on this Mac, never deployed to server):
sp_token: ""
